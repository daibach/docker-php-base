#!/bin/sh
# Called from each service's finish script with: <service> <exit code> <signal>
# If a service exits when it wasn't asked to stop, stop the container so the
# orchestrator can replace it rather than leaving it running without that service.
service=$1
code=$2
signal=$3

# The service was brought down deliberately (e.g. container shutdown)
if [ "$(/command/s6-svstat -o wantedup "/run/service/$service")" = "false" ]; then
  exit 0
fi

if [ "$code" -eq 256 ]; then
  code=$((128 + signal))
fi

echo "php-parent: $service exited unexpectedly (code $code), stopping container" >&2
echo "$code" > /run/s6-linux-init-container-results/exitcode
/run/s6/basedir/bin/halt
